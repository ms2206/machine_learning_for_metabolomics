# Function to find extreme outliers using 3× IQR
find_extreme_outliers_IQR <- function(x) {
Q1 <- quantile(x, 0.25, na.rm = TRUE)
Q3 <- quantile(x, 0.75, na.rm = TRUE)
IQR <- Q3 - Q1
# Use 3× IQR for extreme outliers
extreme_outliers <- which(x < (Q1 - 3 * IQR) | x > (Q3 + 3 * IQR))
return(extreme_outliers)
}
# Initialize vector to store counts
n_extreme_outliers <- numeric(nrow(dca_combined))
names(n_extreme_outliers) <- rownames(dca_combined)
# Loop through each metabolite column
for (col_idx in 4:ncol(dca_combined)) {
metabolite_col <- dca_combined[, col_idx]
# Find which ROWS are extreme outliers for this metabolite
outlier_rows <- find_extreme_outliers_IQR(metabolite_col)
# Increment count for those samples
n_extreme_outliers[outlier_rows] <- n_extreme_outliers[outlier_rows] + 1
}
# Barplot of samples with most extreme outliers
barplot(sort(n_extreme_outliers, decreasing = TRUE)[1:20],
las = 2,
main = "Samples with Most Extreme Outlier Metabolites (3× IQR)",
ylab = "Number of Extreme Outliers",
col = "darkred",
cex.names = 0.7)
# Create a function that returns TRUE/FALSE for each value
is_extreme_outlier <- function(x) {
Q1 <- quantile(x, 0.25, na.rm = TRUE)
Q3 <- quantile(x, 0.75, na.rm = TRUE)
IQR <- Q3 - Q1
# Return logical vector
return(x < (Q1 - 3 * IQR) | x > (Q3 + 3 * IQR))
}
# Apply to all metabolite columns
metabolite_data <- dca_combined[, 4:ncol(dca_combined)]
