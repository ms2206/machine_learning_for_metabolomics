plot(dca_year_1_pca, type = "screeplot", main = "Scree Plot for DCA Year 1 PCA | Scaled & Centered")
plot(dca_year_2_pca, type = "screeplot", main = "Scree Plot for DCA Year 2 PCA | Scaled & Centered")
