# Standard outlier detection uses 1.5 × IQR
# Extreme outlier detection uses 3 × IQR
find_extreme_outliers_IQR <- function(x) {
Q1 <- quantile(x, 0.25, na.rm = TRUE)
Q3 <- quantile(x, 0.75, na.rm = TRUE)
IQR <- Q3 - Q1
# Use 3× IQR for extreme outliers (instead of 1.5×)
extreme_outliers <- which(x < (Q1 - 3 * IQR) | x > (Q3 + 3 * IQR))
return(extreme_outliers)
}
# Count extreme outliers per sample
n_extreme_outliers <- apply(dca_combined[, 4:ncol(dca_combined)], 1, function(sample_row) {
n <- 0
for (i in 1:length(sample_row)) {
metabolite_col <- dca_combined[, i + 3]
if (i %in% find_extreme_outliers_IQR(metabolite_col)) {
n <- n + 1
}
}
return(n)
})
barplot(sort(n_extreme_outliers, decreasing = TRUE)[1:20],
las = 2,
main = "Samples with Most Extreme Outlier Metabolites (3× IQR)",
ylab = "Number of Extreme Outliers",
col = "darkred")
# Count extreme outliers per sample
n_extreme_outliers <- apply(dca_combined[, 4:ncol(dca_combined)], 1, function(sample_row) {
n <- 0
for (i in 1:length(sample_row)) {
metabolite_col <- dca_combined[, i + 3]
if (i %in% find_extreme_outliers_IQR(metabolite_col)) {
n <- n + 1
}
}
return(n)
})
# Corrected function to find extreme outliers using 3× IQR
find_extreme_outliers_IQR <- function(x) {
Q1 <- quantile(x, 0.25, na.rm = TRUE)
Q3 <- quantile(x, 0.75, na.rm = TRUE)
IQR <- Q3 - Q1
# Use 3× IQR for extreme outliers (instead of 1.5×)
extreme_outliers <- which(x < (Q1 - 3 * IQR) | x > (Q3 + 3 * IQR))
return(extreme_outliers)
}
# Count extreme outliers per sample (ONLY for metabolite columns)
n_extreme_outliers <- apply(dca_combined[, 4:ncol(dca_combined)], 1, function(sample_row) {
n <- 0
for (i in 1:length(sample_row)) {
# Get the FULL metabolite column from dca_combined (not just one value)
metabolite_col <- dca_combined[, i + 3]  # This selects column i+3
# Find extreme outliers in this metabolite across ALL samples
outlier_indices <- find_extreme_outliers_IQR(metabolite_col)
# Check if the CURRENT SAMPLE (row) is in the outlier list
# We need to compare the current row number to outlier_indices
# But we need to know which row we're on!
# This is the problem - we need to track row index
}
return(n)
})
