# load libraries
library(ggplot2)
library(caret)
library(dotenv)
library(dplyr)
cat("Loading environment variables from .env file...\n")
tryCatch(
{
dotenv::load_dot_env()
cat("Environment variables loaded successfully.\n")
},
error = function(e) {
cat("Error loading environment variables:", e$message, "\n")
cat("Loading from hardcoded path as fallback...\n")
dotenv::load_dot_env("/Users/mspriggs/Library/CloudStorage/OneDrive-Illumina,Inc./Documents/Applied_Bioinformatics/modules/machine_learning_for_metabolomics/assignment/scripts/.env") # nolint
cat("Loaded .env from hardcoded path\n")
}
)
cat("Setting up global variables and sourcing utility functions...\n")
WORKING_DIR <- Sys.getenv("WORKING_DIR")
# define file paths
UTILS_FILEPATH <- file.path(WORKING_DIR, "scripts", "00_data_prep_utils.R")
DATA_DIR <- file.path(WORKING_DIR, "Assignment_Data")
OUTPUT_DIR <- file.path(WORKING_DIR, "outputs")
PLOTS_DIR <- file.path(OUTPUT_DIR, "plots")
date_str <- format(Sys.Date(), "%Y-%m-%d")
# source utility functions
source(UTILS_FILEPATH)
print(paste("Utility functions sourced from:", UTILS_FILEPATH))
# load DCA Year one as train data
training_data <- load_data(file.path(DATA_DIR, "DCA_Year1.csv"))
# load DCA Year two as test data
test_data <- load_data(file.path(DATA_DIR, "DCA_Year2.csv"))
# remove missing values from DCA Year 1
training_data <- training_data %>% drop_na()
# infer mean for na values in DCA Year 2
test_data <- infer_mean_for_nan(test_data)
# Fix column name mismatch
colnames(training_data)[colnames(training_data) == "X7OH.ABA"] <- "X7.OH.ABA"
# extract features and labels
training_samples <- extract_sample_names(training_data)
rownames(training_data) <- training_samples
training_data <- training_data[, -1]
test_samples <- extract_sample_names(test_data)
rownames(test_data) <- test_samples
test_data <- test_data[, -1]
# convert storage.week and ripening.stage to factors
training_data <- mutate_df_factors(training_data)
test_data <- mutate_df_factors(test_data)
# set order of factor levels
ripeness_stages_order <- c("Early", "Mid", "Late")
training_data$Ripening.Stage <- factor(training_data$Ripening.Stage, levels = ripeness_stages_order)
test_data$Ripening.Stage <- factor(test_data$Ripening.Stage, levels = ripeness_stages_order)
# Check the proportion of each class in the dataset for training_data
round(prop.table(table(training_data$Storage.Week)) * 100, 2)
# get number of samples in each class
table(training_data$Storage.Week)
round(prop.table(table(training_data$Ripening.Stage)) * 100, 2)
# get number of samples in each class
table(training_data$Ripening.Stage)
# remove ripening stage, use only storage week for classification
training_features <- training_data %>%
dplyr::select(-Ripening.Stage)
# rename Storage.Week levels to valid R variable names
training_features$Storage.Week <- factor(
training_features$Storage.Week,
levels = levels(training_features$Storage.Week),
labels = paste0("Week_", levels(training_features$Storage.Week))
)
# use stratified k-fold cross-validation (ensures all weeks in each fold)
train_control <- trainControl(
method = "cv",
number = 5,
classProbs = TRUE,
summaryFunction = multiClassSummary,
savePredictions = "final",
index = createFolds(training_features$Storage.Week, k = 5, list = TRUE, returnTrain = TRUE)
)
set.seed(123) # for reproducibility
# Define parameter grid
tune_grid <- expand.grid(mtry = c(5, 10, 15, 20, 25))
# Train with grid search
rf_model <- train(
Storage.Week ~ .,
data = training_features,
method = "rf",
trControl = train_control,
tuneGrid = tune_grid,
metric = "Accuracy",
ntree = 1000,
importance = TRUE,
preProcess = c("center", "scale")
)
# Prepare test data
test_features <- test_data %>%
dplyr::select(-Ripening.Stage)
# rename Storage.Week to string.
test_features$Storage.Week <- factor(
test_features$Storage.Week,
levels = levels(test_features$Storage.Week),
labels = paste0("Week_", levels(test_features$Storage.Week))
)
# Predict on test data
test_predictions <- predict(rf_model, newdata = test_features)
test_probabilities <- predict(rf_model, newdata = test_features, type = "prob")
# Evaluate performance
conf_matrix <- confusionMatrix(test_predictions, test_features$Storage.Week)
print(conf_matrix)
conf_matrix$table # raw counts
cm_counts <- conf_matrix$table
cm_df <- as.data.frame(conf_matrix$table)
colnames(cm_df) <- c("Reference", "Predicted", "Count")
ggplot(cm_df, aes(x = Reference, y = Predicted, fill = Count)) +
geom_tile() +
geom_text(aes(label = Count), size = 3) +
scale_fill_gradient(low = "white", high = "steelblue") +
theme_minimal() +
labs(title = "Confusion Matrix RF Storage Weeks (Counts)", x = "Predicted", y = "Reference")
